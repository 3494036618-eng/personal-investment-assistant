{
  "name": "investment-assistant-oss",
  "private": true,
  "version": "0.1.3",
  "description": "A source-backed personal investment research assistant powered by Volcengine Agent Plan, DataPro and Doubao Search.",
  "scripts": {
    "app:install": "npm --prefix skill/investment-assistant/assets/app install",
    "app:dev": "npm --prefix skill/investment-assistant/assets/app run dev",
    "app:build": "npm --prefix skill/investment-assistant/assets/app run build",
    "app:test": "npm --prefix skill/investment-assistant/assets/app test",
    "app:check": "npm --prefix skill/investment-assistant/assets/app run check",
    "skill:test": "node scripts/test-initializer.mjs",
    "skill:install": "node scripts/install-codex-skill.mjs",
    "skill:validate": "node scripts/validate-skill.mjs",
    "verify": "npm run app:check && npm run app:test && npm run app:build && npm run skill:test && npm run skill:validate"
  },
  "engines": {
    "node": ">=22.13"
  }
}
